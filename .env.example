# Copy to .env and fill in — never commit .env
# Create a token at https://huggingface.co/settings/tokens
# (enable "Make calls to Inference Providers")
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ollama Cloud (hosted models at ollama.com — separate from local Ollama below)
# Create a key at https://ollama.com/settings/keys
# OLLAMA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_PORT=11434
# HF_BASE_URL=https://router.huggingface.co/v1
# TC_LLM_HOME=/path/to/custom/home
# TC_LOG=debug
