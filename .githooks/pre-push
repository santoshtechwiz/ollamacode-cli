#!/bin/sh
# What may be pushed, per docs/BRANCHING.md, and the checks every pushed branch must pass.
. "$(dirname "$0")/branch-rules.sh"

zero=0000000000000000000000000000000000000000
failed=0
pushes_branch=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote branch or tag (cleaning up after a merge) is always allowed.
  [ "$local_sha" = "$zero" ] && continue

  case "$remote_ref" in
    refs/heads/main|refs/heads/develop)
      echo "ocode: no direct push to '${remote_ref#refs/heads/}'. Push a branch and open a pull request (docs/BRANCHING.md)." >&2
      failed=1
      ;;
    refs/heads/*)
      branch=${remote_ref#refs/heads/}
      problem=$(branch_name_problem "$branch")
      if [ -n "$problem" ]; then
        echo "ocode: $problem" >&2
        failed=1
        continue
      fi
      # A release or hotfix branch carries the version it releases.
      case "$branch" in
        release/*|hotfix/*)
          want=${branch#*/}
          have=$(git show "$local_sha:package.json" 2>/dev/null | sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' | head -n 1)
          if [ "$have" != "$want" ]; then
            echo "ocode: '$branch' must set package.json version to $want (it is '$have'): npm version $want --no-git-tag-version" >&2
            failed=1
          fi
          ;;
      esac
      # A feature branch is work in progress: its pushes skip the typecheck and tests (CI runs them on the pull request).
      case "$branch" in
        feature/*) ;;
        *) pushes_branch=1 ;;
      esac
      ;;
    refs/tags/*)
      tag=${remote_ref#refs/tags/}
      if ! printf '%s\n' "$tag" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
        echo "ocode: only release tags (v<x.y.z>) are pushed; '$tag' stays local (docs/BRANCHING.md)." >&2
        failed=1
      fi
      ;;
  esac
done

[ "$failed" -ne 0 ] && exit 1

# A pushed branch is one a pull request will be opened from: it has to type-check and pass the tests.
if [ "$pushes_branch" -eq 1 ]; then
  echo "ocode: type-checking and running the tests before the push..." >&2
  npm run --silent typecheck || { echo "ocode: typecheck failed; push stopped." >&2; exit 1; }
  npm test --silent >/dev/null 2>&1 || { echo "ocode: tests failed; push stopped. Run: npm test" >&2; exit 1; }
fi
exit 0
